# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# MongoDB Configuration
# Leave as mongodb://localhost:27017/border_guard_db or any valid MongoDB URI.
# If MongoDB is not reachable, the system automatically runs with an in-memory database store!
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=border_guard_db

# Security & CORS
SECRET_KEY=change-this-to-a-super-secret-key-in-production
ALLOWED_ORIGINS=*

# AI Forensics (Optional Gemini API key for multimodal reasoning)
GEMINI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
STATIC_DIR=./static
MAX_FILE_SIZE_MB=15

# Risk Engine Thresholds (0 - 100)
LOW_RISK_THRESHOLD=25
HIGH_RISK_THRESHOLD=65
